{
  "name": "knowledge-tree-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @knowledge-tree/web dev",
    "desktop:dev": "pnpm --filter @knowledge-tree/desktop dev",
    "desktop:pack": "pnpm --filter @knowledge-tree/web build && pnpm --filter @knowledge-tree/desktop pack",
    "desktop:dist": "pnpm --filter @knowledge-tree/web build && pnpm --filter @knowledge-tree/desktop dist",
    "build": "pnpm --filter @knowledge-tree/web build",
    "preview": "pnpm --filter @knowledge-tree/web preview",
    "typecheck": "pnpm --filter @knowledge-tree/web typecheck",
    "lint": "pnpm --filter @knowledge-tree/web lint"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "packageManager": "pnpm@11.2.2"
}
